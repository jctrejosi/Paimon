# Entornos virtuales locales (no versionar)
.venv/

# Cachés de herramientas
.pytest_cache/
.ruff_cache/
__pycache__/

# Logs
*.log

# Imágenes generadas por la API (volumen de datos, no versionar)
image_generator/api/outputs/

# Configuración local de la API (contiene credenciales)
image_generator/api/.env

# Pesos de modelos de transcripción (volumen de datos, no versionar)
audio_processing/api/models/*
!audio_processing/api/models/.gitkeep

# Datos generados por la evaluación de WER (reproducibles, no versionar)
audio_processing/eval/data/
audio_processing/eval/data_real/
audio_processing/eval/.cache/

# Caché de modelos descargados por la evaluación (speechbrain, etc.)
audio_processing/eval/models/

# Configuración local de la API de transcripción (contiene credenciales)
audio_processing/api/.env
