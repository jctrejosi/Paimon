# Copia a `.env` y ajusta. Ninguno de los proveedores externos es obligatorio:
# sin credenciales simplemente no aparecerán como disponibles en /providers.

# --- Servicio -------------------------------------------------------------
# Proveedor por defecto: comfyui | openai | stability | replicate | fal | bfl
IMAGE_PROVIDER=comfyui
# Si se define, `/generate` exige `Authorization: Bearer <token>`.
# IMAGE_API_TOKEN=
# URL base pública para construir enlaces absolutos detrás de un proxy.
# PUBLIC_BASE_URL=https://imagenes.example.com
OUTPUT_DIR=outputs

# --- Jobs asíncronos (/jobs) ---------------------------------------------
# Generaciones simultáneas máximas (1 = serie; ComfyUI en CPU rinde mejor así).
JOB_CONCURRENCY=1
# Dónde se ejecutan los jobs: 'inline' (en la API) o 'worker' (proceso aparte).
JOB_EXECUTION=inline
# Jobs retenidos en el store.
JOBS_MAX=100
# Backend del estado: 'memory' (efímero) o 'redis' (persistente/compartible).
JOB_STORE=memory
# Conexión a Redis cuando JOB_STORE=redis.
REDIS_URL=redis://127.0.0.1:6379/0
# Caducidad (segundos) de cada job en Redis.
JOBS_TTL=86400
# Cada cuánto (segundos) el flujo SSE re-consulta el estado como respaldo.
JOB_STREAM_POLL=2.0
# Latido de un job en curso y umbral para considerarlo huérfano (worker caído).
JOB_HEARTBEAT_INTERVAL=15.0
JOB_STALE_AFTER=60.0
# Margen (segundos) para terminar jobs en curso al apagar el ejecutor.
JOB_SHUTDOWN_GRACE=5.0

# --- Límites de entrada ---------------------------------------------------
# Tamaño máximo del cuerpo de una petición y de una imagen de entrada (bytes).
MAX_REQUEST_BYTES=33554432
MAX_IMAGE_BYTES=20971520

# --- Métricas -------------------------------------------------------------
# Expone /metrics; en el worker, un servidor HTTP en METRICS_PORT.
METRICS_ENABLED=true
METRICS_PORT=9100

# --- ComfyUI (local) ------------------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# Plantilla de workflow alternativa (formato API de ComfyUI).
# COMFYUI_WORKFLOW=workflows/mi_workflow.json

# --- OpenAI (gpt-image-1 / dall-e-3) -------------------------------------
# OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Stability AI ---------------------------------------------------------
# STABILITY_API_KEY=sk-...
STABILITY_IMAGE_MODEL=core

# --- Replicate ------------------------------------------------------------
# REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- fal.ai ---------------------------------------------------------------
# FAL_KEY=...
FAL_MODEL=fal-ai/flux/schnell

# --- Black Forest Labs (FLUX) --------------------------------------------
# BFL_API_KEY=...
BFL_MODEL=flux-schnell
